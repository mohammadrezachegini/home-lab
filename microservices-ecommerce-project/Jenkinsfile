pipeline {
    agent any  // Use built-in executors instead of Kubernetes pods
    
    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_CREDENTIALS = credentials('dockerhub-credentials')
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out code...'
                checkout scm
            }
        }
        
        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                script {
                    // Test each service
                    def services = ['product-service', 'user-service', 'order-service', 'payment-service', 'inventory-service']
                    services.each { service ->
                        echo "Testing ${service}..."
                        // Add actual test commands here based on language
                    }
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                echo '🏗️ Building Docker images...'
                script {
                    def services = [
                        'product-service',
                        'user-service', 
                        'order-service',
                        'payment-service',
                        'inventory-service'
                    ]
                    
                    services.each { service ->
                        echo "Building ${service}..."
                        sh """
                            cd src/${service}
                            docker build -t ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:${IMAGE_TAG} .
                            docker tag ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:${IMAGE_TAG} \
                                       ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:latest
                        """
                    }
                }
            }
        }
        
        stage('Push to Registry') {
            steps {
                echo '📤 Pushing images to Docker Hub...'
                script {
                    sh "echo ${DOCKER_CREDENTIALS_PSW} | docker login -u ${DOCKER_CREDENTIALS_USR} --password-stdin"
                    
                    def services = ['product-service', 'user-service', 'order-service', 'payment-service', 'inventory-service']
                    services.each { service ->
                        sh """
                            docker push ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:${IMAGE_TAG}
                            docker push ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:latest
                        """
                    }
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                echo '🚀 Deploying to Kubernetes...'
                script {
                    sh """
                        kubectl set image deployment/product-service \
                            product-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/product-service:${IMAGE_TAG} \
                            -n ecommerce
                        
                        kubectl set image deployment/user-service \
                            user-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/user-service:${IMAGE_TAG} \
                            -n ecommerce
                        
                        kubectl set image deployment/order-service \
                            order-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/order-service:${IMAGE_TAG} \
                            -n ecommerce
                        
                        kubectl set image deployment/payment-service \
                            payment-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/payment-service:${IMAGE_TAG} \
                            -n ecommerce
                        
                        kubectl set image deployment/inventory-service \
                            inventory-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/inventory-service:${IMAGE_TAG} \
                            -n ecommerce
                    """
                }
            }
        }
        
        stage('Verify Deployment') {
            steps {
                echo '✅ Verifying deployment...'
                sh """
                    kubectl rollout status deployment/product-service -n ecommerce --timeout=5m
                    kubectl rollout status deployment/user-service -n ecommerce --timeout=5m
                    kubectl rollout status deployment/order-service -n ecommerce --timeout=5m
                    kubectl rollout status deployment/payment-service -n ecommerce --timeout=5m
                    kubectl rollout status deployment/inventory-service -n ecommerce --timeout=5m
                """
            }
        }
    }
    
    post {
        success {
            echo '🎉 Pipeline succeeded!'
            echo "Build: ${env.BUILD_NUMBER}"
            echo "Image Tag: ${IMAGE_TAG}"
        }
        failure {
            echo '❌ Pipeline failed!'
            echo 'Check logs for details'
        }
        always {
            echo '🧹 Cleaning up...'
            sh 'docker system prune -f || true'
        }
    }
}