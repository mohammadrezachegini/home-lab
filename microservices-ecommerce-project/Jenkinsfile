pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_CREDENTIALS = credentials('dockerhub-credentials')
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        PROJECT_DIR = "microservices-ecommerce-project"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out code...'
                checkout scm
            }
        }
        
        stage('Environment Check') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        echo "✅ Docker: $(docker --version)"
                        echo "✅ kubectl: $(kubectl version --client --short 2>/dev/null || echo 'installed')"
                        echo "✅ Build: ${BUILD_NUMBER}"
                    '''
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                dir("${PROJECT_DIR}") {
                    script {
                        def services = ['product-service', 'user-service', 'order-service', 'payment-service', 'inventory-service']
                        
                        for (service in services) {
                            echo "Building ${service}..."
                            sh """
                                cd src/${service}
                                docker build -t ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:${IMAGE_TAG} .
                                docker tag ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:${IMAGE_TAG} \
                                           ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/${service}:latest
                                echo "✅ ${service} built"
                                cd ../..
                            """
                        }
                    }
                }
            }
        }
        
        stage('Push to Registry') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        echo "Logging in to Docker Hub..."
                        echo ${DOCKER_CREDENTIALS_PSW} | docker login -u ${DOCKER_CREDENTIALS_USR} --password-stdin
                        
                        echo "Pushing images..."
                        docker push ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/product-service:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/user-service:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/order-service:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/payment-service:${IMAGE_TAG}
                        docker push ${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/inventory-service:${IMAGE_TAG}
                        echo "✅ All images pushed!"
                    '''
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        echo "Deploying to Kubernetes..."
                        kubectl set image deployment/product-service product-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/product-service:${IMAGE_TAG} -n ecommerce
                        kubectl set image deployment/user-service user-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/user-service:${IMAGE_TAG} -n ecommerce
                        kubectl set image deployment/order-service order-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/order-service:${IMAGE_TAG} -n ecommerce
                        kubectl set image deployment/payment-service payment-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/payment-service:${IMAGE_TAG} -n ecommerce
                        kubectl set image deployment/inventory-service inventory-service=${DOCKER_REGISTRY}/${DOCKER_CREDENTIALS_USR}/inventory-service:${IMAGE_TAG} -n ecommerce
                        echo "✅ Deployment complete!"
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo '🎉 Pipeline succeeded!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}