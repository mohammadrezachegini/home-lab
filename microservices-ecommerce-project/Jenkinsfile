pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'docker.io'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out code from GitHub...'
                checkout scm
            }
        }
        
        stage('Environment Check') {
            steps {
                echo '🔍 Checking environment...'
                sh 'echo "Jenkins Home: $JENKINS_HOME"'
                sh 'echo "Workspace: $WORKSPACE"'
                sh 'echo "Build Number: $BUILD_NUMBER"'
                sh 'pwd'
                sh 'ls -la'
            }
        }
        
        stage('Verify Services') {
            steps {
                echo '📁 Verifying service directories...'
                sh '''
                    cd src
                    ls -la
                    echo "✅ All service directories found"
                '''
            }
        }
        
        stage('Run Tests') {
            steps {
                echo '🧪 Running tests...'
                sh '''
                    echo "Testing Product Service..."
                    test -d src/product-service && echo "✅ Product service found"
                    
                    echo "Testing User Service..."
                    test -d src/user-service && echo "✅ User service found"
                    
                    echo "Testing Order Service..."
                    test -d src/order-service && echo "✅ Order service found"
                    
                    echo "Testing Payment Service..."
                    test -d src/payment-service && echo "✅ Payment service found"
                    
                    echo "Testing Inventory Service..."
                    test -d src/inventory-service && echo "✅ Inventory service found"
                '''
            }
        }
        
        stage('Build Info') {
            steps {
                echo '🏗️ Build Information'
                sh '''
                    echo "================================"
                    echo "Build Number: ${BUILD_NUMBER}"
                    echo "Image Tag: ${IMAGE_TAG}"
                    echo "Git Commit: $(git rev-parse --short HEAD)"
                    echo "Git Branch: $(git rev-parse --abbrev-ref HEAD)"
                    echo "================================"
                '''
            }
        }
        
        stage('Generate Report') {
            steps {
                echo '📊 Generating report...'
                sh '''
                    echo "================================"
                    echo "PIPELINE EXECUTION REPORT"
                    echo "================================"
                    echo "Status: Running"
                    echo "Date: $(date)"
                    echo "Build: ${BUILD_NUMBER}"
                    echo "================================"
                '''
            }
        }
    }
    
    post {
        success {
            echo '🎉 ================================'
            echo '🎉 PIPELINE SUCCEEDED!'
            echo '🎉 ================================'
            sh 'echo "Build ${BUILD_NUMBER} completed successfully"'
        }
        
        failure {
            echo '❌ ================================'
            echo '❌ PIPELINE FAILED!'
            echo '❌ ================================'
            sh 'echo "Build ${BUILD_NUMBER} failed"'
        }
        
        always {
            echo '🧹 Cleanup complete'
        }
    }
}
